{
  "description": "Ask the agent to offer Bird feedback, with the user's approval, after a Bird tool fails.",
  "hooks": {
    "PostToolUseFailure": [
      {
        "matcher": "^(Skill|mcp__(plugin_bird_bird|bird|claude_ai_Bird)__.*)$",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/tool-failure.mjs"],
            "timeout": 5
          }
        ]
      }
    ]
  }
}
